    {
      "parameters": {
        "jsCode": "const response = $json;\n\nconsole.log('📊 Validating response...');\n\n// ============================================\n// HELPER: Create error response\n// ============================================\nfunction createErrorResponse(message, originalResponse) {\n    return {\n        validationError: true,\n        message: message,\n        timestamp: new Date().toISOString(),\n        originalResponse: originalResponse || null\n    };\n}\n\n// ============================================\n// HELPER: Create success response\n// ============================================\nfunction createSuccessResponse(data) {\n    return {\n        validationError: false,  // ✅ Explicitly set to false\n        ...data\n    };\n}\n\n// ============================================\n// VALIDATION LOGIC\n// ============================================\ntry {\n\n    // 🧪 TEST: force an error to verify the error alert flow — remove after testing\n    // throw new Error(\"TEST: forced validation error to trigger error alert flow\");\n\n\n    // 1. Check required fields\n    const required = ['ideas', 'draft', 'confidence', 'hashtags', 'status', 'minimum_confidence', 'dry_run'];\n    const missing = required.filter(f => !response[f]);\n\n    if (missing.length > 0) {\n        return createErrorResponse(`Missing required fields: ${missing.join(', ')}`, response);\n    }\n\n    // 2. Validate confidence (0-1)\n    if (response.confidence < 0 || response.confidence > 1) {\n        return createErrorResponse(`Invalid confidence score: ${response.confidence}`, response);\n    }\n\n    // 🔥 Confidence === 0 is an ERROR\n    if (response.confidence === 0) {\n        const reason = response.confidence_reason || 'No reason provided';\n        return createErrorResponse(`Confidence score is 0. Evaluator failed or bias detected: ${reason}`, response);\n    }\n\n    // 3. Validate minimum_confidence (0-1)\n    if (response.minimum_confidence < 0 || response.minimum_confidence > 1) {\n        return createErrorResponse(`Invalid minimum_confidence: ${response.minimum_confidence}`, response);\n    }\n\n    // 4. Validate dry_run is boolean\n    if (typeof response.dry_run !== 'boolean') {\n        return createErrorResponse(`dry_run must be a boolean, got ${typeof response.dry_run}`, response);\n    }\n\n    // 5. Validate hashtags is an array\n    if (!Array.isArray(response.hashtags)) {\n        return createErrorResponse('Hashtags must be an array', response);\n    }\n\n    // 6. Validate hashtags has at least 1 item\n    if (response.hashtags.length === 0) {\n        return createErrorResponse('Hashtags must have at least one tag', response);\n    }\n\n    // 7. Validate ideas is an array\n    if (!Array.isArray(response.ideas)) {\n        return createErrorResponse('ideas must be an array', response);\n    }\n\n    // 8. Validate draft exists\n    if (!response.draft || response.draft.length < 10) {\n        return createErrorResponse('draft must be at least 10 characters', response);\n    }\n\n    // 9. Validate status (warning only)\n    const validStatuses = ['AI_GENERATED', 'AI_REVISED', 'AI_REJECTED', 'ERROR'];\n    if (!validStatuses.includes(response.status)) {\n        console.warn(`⚠️ Unknown status: ${response.status}`);\n    }\n\n    // 10. Validate confidence_reason (warning only)\n    if (!response.confidence_reason || response.confidence_reason.length === 0) {\n        console.warn('⚠️ confidence_reason is empty or missing');\n    }\n\n    console.log(`✅ Response validation passed. Confidence: ${response.confidence}`);\n    \n    // ✅ Return success with explicit validationError: false\n    return createSuccessResponse(response);\n\n} catch (error) {\n    console.error('❌ Unexpected validation error:', error.message);\n    return createErrorResponse(`Unexpected error: ${error.message}`, response);\n}"
      },
